# Copy to .env.local and fill in what you need. EVERYTHING IS OPTIONAL:
# with no env vars the app still scans and shows reports (results live in
# localStorage instead of a database, and no emails are sent).

# --- Database (Supabase) — enables caching, shareable report links, rate limiting, leads
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Email (Resend) — sends the report link after the email gate
RESEND_API_KEY=
EMAIL_FROM="AI Visibility Audit <audit@yourdomain.com>"
SITE_URL=http://localhost:3000

# --- LLM visibility check — each key enables one provider; missing keys are skipped
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=

# --- Optional CTA on the report page (hidden when unset)
NEXT_PUBLIC_CTA_URL=
NEXT_PUBLIC_CTA_LABEL=
NEXT_PUBLIC_CTA_TEXT=
